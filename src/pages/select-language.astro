---
import { Font } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import Favicon from "~/components/Favicon.astro";
import { LOCALES } from "~/constants/locales";
import "~/styles/globals.css";
import { exhaustiveCheck } from "~/utils/exhaustive-check";

const localeOptions = Object.values(LOCALES).map((locale) => {
  switch (locale) {
    case LOCALES.EN:
      return {
        locale,
        label: "English",
        description: "Browse the site in English.",
        cta: "Continue in English",
      };
    case LOCALES.DE:
      return {
        locale,
        label: "Deutsch",
        description: "Website auf Deutsch anzeigen.",
        cta: "Weiter auf Deutsch",
      };
    default:
      return exhaustiveCheck(locale);
  }
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <Font cssVariable="--font-merriweather" preload={true} />
    <Favicon />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Choose your language to continue to the localized site."
    />
    <title>Choose a language</title>
  </head>
  <body class="font-serif text-base">
    <main class="mx-auto flex min-h-screen max-w-4xl items-center px-6 py-16">
      <div class="w-full space-y-8 text-center">
        <div class="space-y-3">
          <p class="text-sm tracking-[0.3em] text-pine-teal uppercase">
            Welcome
          </p>
          <h1 class="text-4xl font-semibold text-hunter-green md:text-5xl">
            Choose your language
          </h1>
          <p class="mx-auto max-w-2xl text-lg text-pine-teal">
            This site is localized. Select a language to continue.
          </p>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          {
            localeOptions.map((option) => (
              <a
                class="group rounded-3xl border border-dust-grey/70 bg-dust-grey/40 p-6 text-left transition hover:border-dry-sage hover:bg-dust-grey/60 focus-visible:outline-offset-4"
                href={getRelativeLocaleUrl(option.locale)}
                hreflang={option.locale}
                lang={option.locale}
              >
                <div class="flex items-start justify-between gap-4">
                  <div class="space-y-2">
                    <h2 class="text-2xl font-semibold text-hunter-green">
                      {option.label}
                    </h2>
                    <p class="text-sm text-pine-teal">{option.description}</p>
                  </div>
                  <span class="rounded-full bg-fern px-4 py-2 text-xs font-semibold text-dust-grey">
                    {option.locale.toUpperCase()}
                  </span>
                </div>
                <div class="pt-5 text-sm font-semibold text-hunter-green">
                  {option.cta}
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </main>
  </body>
</html>
