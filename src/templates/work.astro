---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "~/layouts/Layout.astro";
import { getCurrentLocale } from "~/utils/get-current-locale";

type Props = {
  t: {
    page: {
      title: string;
      description: string;
    };
    kicker: string;
    title: string;
    description: string;
    projectsTitle: string;
    projects: {
      title: string;
      description: string;
      tags: string[];
    }[];
    servicesTitle: string;
    services: string[];
    availabilityTitle: string;
    availabilityBody: string;
    ctaLabel: string;
  };
};

const { t } = Astro.props;
const currentLocale = getCurrentLocale(Astro);
---

<Layout description={t.page.description} title={t.page.title}>
  <div class="px-6 py-16">
    <div class="mx-auto max-w-4xl space-y-10">
      <section class="space-y-4 text-center">
        <p class="text-sm tracking-[0.3em] text-pine-teal uppercase">
          {t.kicker}
        </p>
        <h1 class="text-4xl font-semibold text-hunter-green md:text-5xl">
          {t.title}
        </h1>
        <p class="text-lg text-pine-teal">{t.description}</p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold text-hunter-green">
          {t.projectsTitle}
        </h2>
        <div class="grid gap-6 md:grid-cols-3">
          {
            t.projects.map((project) => (
              <article class="rounded-2xl bg-dust-grey/40 p-5">
                <h3 class="text-lg font-semibold text-hunter-green">
                  {project.title}
                </h3>
                <p class="mt-2 text-sm text-pine-teal">{project.description}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="rounded-full border border-dry-sage px-3 py-1 text-xs font-semibold text-hunter-green">
                      {tag}
                    </span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl bg-dust-grey/40 p-5">
          <h2 class="text-lg font-semibold text-hunter-green">
            {t.servicesTitle}
          </h2>
          <ul class="mt-3 space-y-2 text-sm text-pine-teal">
            {
              t.services.map((service) => (
                <li class="flex gap-2">
                  <span class="text-fern">•</span>
                  <span>{service}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-2xl bg-dust-grey/40 p-5">
          <h2 class="text-lg font-semibold text-hunter-green">
            {t.availabilityTitle}
          </h2>
          <p class="mt-2 text-sm text-pine-teal">{t.availabilityBody}</p>
          <div class="mt-4">
            <a
              class="rounded-full bg-fern px-5 py-2 text-sm font-semibold text-dust-grey"
              href={getRelativeLocaleUrl(currentLocale, "contact")}
            >
              {t.ctaLabel}
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>
