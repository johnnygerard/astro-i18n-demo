---
import { getRelativeLocaleUrl } from "astro:i18n";
import { LOCALES } from "~/constants/locales";
import { getCurrentPath } from "~/utils/get-current-path";

if (Object.values(LOCALES).length !== 2)
  throw new Error("This component only supports two locales.");

const { currentLocale, locals } = Astro;
const targetLocale = currentLocale === LOCALES.EN ? LOCALES.DE : LOCALES.EN;

// Compute URL path without locale prefix
// Note that the homepage ("/en", "/de") is an edge case that requires special handling
const neutralPath = getCurrentPath(Astro).replace(`/${currentLocale}`, "");

const shouldLinkToHomepage =
  neutralPath === "" ||
  (locals.requestPathBeforeRewrite && !locals.requestHasSupportedLocale);

const href = shouldLinkToHomepage
  ? getRelativeLocaleUrl(targetLocale)
  : getRelativeLocaleUrl(targetLocale, neutralPath);
---

<a
  href={href}
  hreflang={targetLocale}
  title={{
    de: "Switch to German",
    en: "Wechseln zu Englisch",
  }[targetLocale]}
  class="rounded-full border-2 border-hunter-green px-3 py-1 text-sm font-semibold text-hunter-green transition-colors hover:bg-hunter-green hover:text-dust-grey"
  >{targetLocale.toUpperCase()}</a
>
