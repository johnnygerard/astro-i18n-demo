---
import { getRelativeLocaleUrl } from "astro:i18n";
import LanguageToggle from "~/components/LanguageToggle.astro";
import type { Locale } from "~/types/locale";
import { getCurrentLocale } from "~/utils/get-current-locale";

const currentLocale = getCurrentLocale(Astro);

const navLinks: Array<{
  href: string;
  labels: Record<Locale, string>;
  rel?: string;
}> = [
  {
    href: getRelativeLocaleUrl(currentLocale),
    labels: {
      en: "Home",
      de: "Startseite",
    },
    rel: "home",
  },
  {
    href: getRelativeLocaleUrl(currentLocale, "work"),
    labels: {
      en: "Work",
      de: "Arbeit",
    },
  },
  {
    href: getRelativeLocaleUrl(currentLocale, "contact"),
    labels: {
      en: "Contact",
      de: "Kontakt",
    },
  },
];
---

<header class="w-full">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-6"
  >
    <nav
      aria-label="Primary"
      class="flex flex-wrap items-center gap-2 rounded-full border border-dust-grey/70 bg-dust-grey/40 px-2 py-1 text-sm font-semibold"
    >
      {
        navLinks.map(({ href, rel, labels }) => (
          <a
            class="rounded-full px-3 py-1 text-hunter-green transition hover:bg-dust-grey/70 focus-visible:outline-offset-2"
            href={href}
            rel={rel}
          >
            {labels[currentLocale]}
          </a>
        ))
      }
    </nav>
    <LanguageToggle />
  </div>
</header>
