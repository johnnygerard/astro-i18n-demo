---
import { Font } from "astro:assets";
import Header from "~/components/Header.astro";
import "~/styles/globals.css";

type Props = {
  title: string;
};

const { title } = Astro.props;
---

<!doctype html>
<html lang={Astro.currentLocale}>
  <head>
    <meta charset="utf-8" />
    <Font cssVariable="--font-merriweather" preload={true} />
    <link
      rel="icon"
      href="/assets/images/favicon-light.png"
      media="(prefers-color-scheme: light)"
      type="image/png"
      sizes="32x32"
    />
    <link
      rel="icon"
      href="/assets/images/favicon-dark.png"
      media="(prefers-color-scheme: dark)"
      type="image/png"
      sizes="32x32"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="font-serif text-base">
    {/* This wrapper prevents a body overflow in mobile browsers. */}
    <div class="flex min-h-screen flex-col">
      <Header />
      <main class="grid flex-1 items-center">
        <slot />
      </main>
    </div>
  </body>
</html>
